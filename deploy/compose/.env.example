# Sample values for LOCAL DEVELOPMENT ONLY. Copied to .env by scripts/dev.*; .env is not
# committed. Nothing here is used in test or production, where values come from the secret
# store. Keys are documented in specs/001-platform-foundation/data-model.md.

# --- Local SQL Server container ---
SCS_SQL_PORT=14333
SCS_SQL_ADMIN_PASSWORD=Local-Admin-Pw-1
SCS_DB_NAME=scs
SCS_APP_PASSWORD=Local-App-Pw-1
SCS_REPORT_PASSWORD=Local-Report-Pw-1
SCS_OPS_PASSWORD=Local-Ops-Pw-1
SCS_MIGRATOR_PASSWORD=Local-Migrator-Pw-1

# --- Platform ---
SCS_ENVIRONMENT=local
SCS_ROLE=all
SCS_DB__CONNECTION=Server=localhost,14333;Database=scs;User Id=scs_app;Password=Local-App-Pw-1;TrustServerCertificate=true
SCS_DB__REPORT_CONNECTION=Server=localhost,14333;Database=scs;User Id=scs_report;Password=Local-Report-Pw-1;TrustServerCertificate=true
SCS_DB__CROSSING_CONNECTION=Server=localhost,14333;Database=scs;User Id=scs_ops;Password=Local-Ops-Pw-1;TrustServerCertificate=true
SCS_DB__MIGRATION_CONNECTION=Server=localhost,14333;Database=scs;User Id=scs_migrator;Password=Local-Migrator-Pw-1;TrustServerCertificate=true
SCS_CORS__ORIGINS=http://localhost:4201,http://localhost:4202,http://localhost:4203
SCS_APIDOCS__ENABLED=true
SCS_VERSION=0.0.0-local

# --- Local mail catcher (inbox at http://localhost:8025) ---
SCS_MAIL_SMTP_PORT=1025
SCS_MAIL_INBOX_PORT=8025
SCS_MAIL__HOST=localhost
SCS_MAIL__PORT=1025
SCS_MAIL__USE_TLS=false
SCS_MAIL__USER=
SCS_MAIL__PASSWORD=
SCS_MAIL__FROM=no-reply@scs.localhost

# --- Sign-in (spec 003). Every value has a default except the key. ---
# SAMPLE KEY for local development only: 32 random bytes in base64. Never use it elsewhere.
SCS_AUTH__CODE_KEY=bG9jYWwtc2FtcGxlLWtleS1ub3QtZm9yLXByb2R1Y3Rpb24h
SCS_AUTH__MAX_FAILED_ATTEMPTS=5
SCS_AUTH__ATTEMPT_WINDOW_MINUTES=15
SCS_AUTH__LOCK_MINUTES=15
SCS_AUTH__CODE_MINUTES=10
SCS_AUTH__CODE_ATTEMPTS=5
SCS_AUTH__MAX_SPENT_CODES=3
SCS_AUTH__RESEND_SECONDS=60
SCS_AUTH__MAX_RESENDS=3
SCS_AUTH__SESSION_HOURS=12
SCS_AUTH__ACCESS_MINUTES=5
SCS_AUTH__RENEWAL_GRACE_SECONDS=30
SCS_AUTH__REQUESTS_PER_MINUTE=10
SCS_AUTH__RENEWALS_PER_MINUTE=120
SCS_AUTH__EMAIL_CODE_ENABLED=true
SCS_AUTH__COOKIE_PATH_BASE=

# --- Help window on the sign-in screens (sample values from the BRD) ---
SCS_SUPPORT__HOURS_AR=يتابع فريق الدعم الطلبات من السبت إلى الخميس، من ٩:٠٠ ص إلى ٩:٠٠ م بتوقيت القاهرة.
SCS_SUPPORT__HOURS_EN=The support team handles requests Saturday to Thursday, 9:00 AM to 9:00 PM Cairo time.
SCS_SUPPORT__HOTLINE=19999
SCS_SUPPORT__WHATSAPP=201000000000
SCS_SUPPORT__EMAIL=support@scs.localhost

# --- Made-up staff accounts (seed). SAMPLE PASSWORD for local and test only. ---
SCS_SEED__STAFF_PASSWORD=Local-Staff-Pw-1!
