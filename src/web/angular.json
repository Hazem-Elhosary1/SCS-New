{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "clinic": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/clinic",
      "sourceRoot": "projects/clinic/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/clinic/src/main.ts",
            "tsConfig": "projects/clinic/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/clinic/public"
              }
            ],
            "styles": ["projects/clinic/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "clinic:build:production"
            },
            "development": {
              "buildTarget": "clinic:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/clinic/**/*.ts", "projects/clinic/**/*.html"],
            "eslintConfig": "projects/clinic/eslint.config.js"
          }
        }
      }
    },
    "patient": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/patient",
      "sourceRoot": "projects/patient/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/patient/src/main.ts",
            "tsConfig": "projects/patient/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/patient/public"
              }
            ],
            "styles": ["projects/patient/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "patient:build:production"
            },
            "development": {
              "buildTarget": "patient:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4202
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/patient/**/*.ts", "projects/patient/**/*.html"],
            "eslintConfig": "projects/patient/eslint.config.js"
          }
        }
      }
    },
    "ops": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/ops",
      "sourceRoot": "projects/ops/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
