      <bpmndi:BPMNShape id="S_manual_di" bpmnElement="S_manual"><dc:Bounds x="2089" y="627" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2061" y="667" width="93" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_manual_di" bpmnElement="SP_manual" isExpanded="false"><dc:Bounds x="2227" y="597" width="140" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_manual_di" bpmnElement="E_manual"><dc:Bounds x="2469" y="627" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2422" y="667" width="130" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_renew_di" bpmnElement="S_renew"><dc:Bounds x="1329" y="817" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1294" y="857" width="105" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_invoice_di" bpmnElement="T_invoice"><dc:Bounds x="1467" y="787" width="140" height="96" /></bpmndi:BPMNShape>
