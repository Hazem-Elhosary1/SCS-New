<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ops-lifecycle" name="Ops console — clinic onboarding, subscription and support lifecycle" targetNamespace="https://scs.clinic/bpmn" exporter="SCS BPMN generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_ops-lifecycle">
    <bpmn:documentation>Operator-side lifecycle of a clinic account: onboarding, renewal billing through Fawry, automatic reminders and suspension, and support tickets.</bpmn:documentation>
    <bpmn:participant id="Participant_clinic" name="Clinic — owner &amp; staff" />
    <bpmn:participant id="Participant_ops" name="SCS Ops Console — Heta operators" processRef="Process_ops" />
    <bpmn:participant id="Participant_fawry" name="Fawry" />
    <bpmn:messageFlow id="MessageFlow_1" name="POST /tickets" sourceRef="Participant_clinic" targetRef="S_ticket" />
    <bpmn:messageFlow id="MessageFlow_2" name="ticket update emails (Resend)" sourceRef="T_work" targetRef="Participant_clinic" />
    <bpmn:messageFlow id="MessageFlow_3" name="reminder email (Resend)" sourceRef="T_remind" targetRef="Participant_clinic" />
    <bpmn:messageFlow id="MessageFlow_4" name="invitation email (Resend)" sourceRef="T_invite" targetRef="Participant_clinic" />
    <bpmn:messageFlow id="MessageFlow_5" name="invoice email (Resend)" sourceRef="T_email" targetRef="Participant_clinic" />
    <bpmn:messageFlow id="MessageFlow_6" name="create checkout link" sourceRef="T_link" targetRef="Participant_fawry" />
    <bpmn:messageFlow id="MessageFlow_7" name="webhook · poller · return page" sourceRef="Participant_fawry" targetRef="W_pay" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ops" name="SCS Ops Console — Heta operators" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ops">
      <bpmn:lane id="Lane_auto" name="Platform automation (timers)">
        <bpmn:flowNodeRef>S_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_grace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_suspend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_susp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_keep</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sup" name="Support">
        <bpmn:flowNodeRef>S_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_sla</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_op" name="Account manager / operator">
        <bpmn:flowNodeRef>S_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_channels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_am</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_live</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_manual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bill" name="Billing">
        <bpmn:flowNodeRef>S_renew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_renewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_t2" name="14 / 7 / 1 days before expiry">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S_t2_def" />
    </bpmn:startEvent>
    <bpmn:sendTask id="T_remind" name="Send renewal reminder">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_rem" name="Reminded">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_t1" name="Hourly check">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S_t1_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_grace" name="Grace over &amp; auto-suspend on?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_suspend" name="Suspend clinic">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_susp" name="Suspended">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_keep" name="No change">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_ticket" name="Ticket created">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S_ticket_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="T_triage" name="Triage &amp; start SLA clock">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_work" name="Reply · escalate · hold · reassign">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_sla" name="SLA warning / breach" attachedToRef="T_work" cancelActivity="false">
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_sla_def" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="G_res" name="Resolved?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_closed" name="Closed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_sla" name="Bell + email alert to operators">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_new" name="New clinic agreed">
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_create" name="Create clinic">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_invite" name="Send owner invitation">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T_channels" name="Configure channels &amp; bot">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_am" name="Assign account manager">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_live" name="Clinic active (trial)">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_manual" name="Operator action">
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SP_manual" name="Manual subscription actions">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="E_manual" name="History entry written">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_renew" name="Renewal initiated">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_invoice" name="Create renewal invoice">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_link" name="Create Fawry checkout link">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_email" name="Email invoice &amp; link">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="W_pay" name="Payment result">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="W_pay_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G_paid" name="Paid in full?">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_settle" name="Settle &amp; extend expiry">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_renewed" name="Renewed">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_failed" name="payment_failed">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S_t2" targetRef="T_remind">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T_remind" targetRef="E_rem">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="S_t1" targetRef="G_grace">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="G_grace" targetRef="T_suspend" name="yes">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T_suspend" targetRef="E_susp">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="G_grace" targetRef="E_keep" name="no">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="S_ticket" targetRef="T_triage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T_triage" targetRef="T_work">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T_work" targetRef="G_res">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="G_res" targetRef="E_closed" name="yes">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="G_res" targetRef="T_work" name="no">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="B_sla" targetRef="E_sla">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="S_new" targetRef="T_create">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="T_create" targetRef="T_invite">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T_invite" targetRef="T_channels">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T_channels" targetRef="T_am">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T_am" targetRef="E_live">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="S_manual" targetRef="SP_manual">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="SP_manual" targetRef="E_manual">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="S_renew" targetRef="T_invoice">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="T_invoice" targetRef="T_link">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="T_link" targetRef="T_email">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="T_email" targetRef="W_pay">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="W_pay" targetRef="G_paid">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="G_paid" targetRef="T_settle" name="yes">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="T_settle" targetRef="E_renewed">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="G_paid" targetRef="E_failed" name="declined">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ops-lifecycle">
    <bpmndi:BPMNPlane id="BPMNPlane_ops-lifecycle" bpmnElement="Collaboration_ops-lifecycle">
      <bpmndi:BPMNShape id="Participant_clinic_di" bpmnElement="Participant_clinic" isHorizontal="true"><dc:Bounds x="40" y="40" width="2772" height="70" /></bpmndi:BPMNShape>
