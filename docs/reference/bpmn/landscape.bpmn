<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_landscape" name="Integration landscape — SCS platform and external parties" targetNamespace="https://scs.clinic/bpmn" exporter="SCS BPMN generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_landscape">
    <bpmn:documentation>Context map: which lane of the platform owns each integration and what crosses each boundary. Sequence flows are indicative; see the lifecycle diagrams for the processes.</bpmn:documentation>
    <bpmn:participant id="Participant_patient" name="Patient" />
    <bpmn:participant id="Participant_meta" name="Meta WhatsApp Cloud API" />
    <bpmn:participant id="Participant_tg" name="Telegram Bot API" />
    <bpmn:participant id="Participant_scs" name="SCS Platform" processRef="Process_scs" />
    <bpmn:participant id="Participant_fawry" name="Fawry" />
    <bpmn:participant id="Participant_resend" name="Resend (email)" />
    <bpmn:participant id="Participant_anthropic" name="Anthropic API" />
    <bpmn:participant id="Participant_twilio" name="Twilio SMS" />
    <bpmn:messageFlow id="MessageFlow_1" name="chat" sourceRef="Participant_patient" targetRef="Participant_meta" />
    <bpmn:messageFlow id="MessageFlow_2" name="chat" sourceRef="Participant_patient" targetRef="Participant_tg" />
    <bpmn:messageFlow id="MessageFlow_3" name="webhook POST (messages)" sourceRef="Participant_meta" targetRef="wa" />
    <bpmn:messageFlow id="MessageFlow_4" name="send message" sourceRef="wa" targetRef="Participant_meta" />
    <bpmn:messageFlow id="MessageFlow_5" name="webhook POST" sourceRef="Participant_tg" targetRef="tga" />
    <bpmn:messageFlow id="MessageFlow_6" name="sendMessage · setWebhook" sourceRef="tga" targetRef="Participant_tg" />
    <bpmn:messageFlow id="MessageFlow_7" name="checkout link · status · refund" sourceRef="bill" targetRef="Participant_fawry" />
    <bpmn:messageFlow id="MessageFlow_8" name="webhook · return page" sourceRef="Participant_fawry" targetRef="bill" />
    <bpmn:messageFlow id="MessageFlow_9" name="send email" sourceRef="mail" targetRef="Participant_resend" />
    <bpmn:messageFlow id="MessageFlow_10" name="delivery events webhook" sourceRef="Participant_resend" targetRef="mail" />
    <bpmn:messageFlow id="MessageFlow_11" name="messages API" sourceRef="ai" targetRef="Participant_anthropic" />
    <bpmn:messageFlow id="MessageFlow_12" name="send test SMS" sourceRef="sms" targetRef="Participant_twilio" />
  </bpmn:collaboration>
  <bpmn:process id="Process_scs" name="SCS Platform" isExecutable="false">
    <bpmn:laneSet id="LaneSet_scs">
      <bpmn:lane id="Lane_chan" name="Platform — channel adapters &amp; conversations">
        <bpmn:flowNodeRef>wa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_clinic" name="Clinic app — clinic staff">
        <bpmn:flowNodeRef>inbox</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clsub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clauth</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ops" name="Ops console — Heta operators">
        <bpmn:flowNodeRef>opch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opbill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>optk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opset</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_api" name="Platform — billing, email, AI, jobs">
        <bpmn:flowNodeRef>core</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="wa" name="WhatsApp adapter">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="tga" name="Telegram adapter">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="conv" name="Conversations &amp; greeting">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="inbox" name="Inbox replies">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="cl" name="Bookings · queue · records · invoices">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="clsub" name="Subscription status &amp; read-only banner">
    </bpmn:userTask>
    <bpmn:userTask id="clauth" name="Sign-in codes · invitations · resets">
    </bpmn:userTask>
    <bpmn:userTask id="opch" name="Channel setup &amp; bot toggles">
    </bpmn:userTask>
    <bpmn:userTask id="opbill" name="Renewals · invoices · suspension">
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="optk" name="Tickets · notifications · audit">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="opai" name="AI suggestions on the dashboard">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="opset" name="Platform settings &amp; environment banner">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="core" name="Clinic domain API">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="bill" name="Subscription billing">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="mail" name="Email service">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ai" name="AI suggestions job">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="sms" name="SMS test sender">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="wa" targetRef="conv">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="tga" targetRef="conv">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="conv" targetRef="inbox">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="cl" targetRef="core">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="opbill" targetRef="bill">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="optk" targetRef="mail">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ai" targetRef="opai">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="opset" targetRef="sms">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_landscape">
    <bpmndi:BPMNPlane id="BPMNPlane_landscape" bpmnElement="Collaboration_landscape">
      <bpmndi:BPMNShape id="Participant_patient_di" bpmnElement="Participant_patient" isHorizontal="true"><dc:Bounds x="122" y="40" width="360" height="90" /></bpmndi:BPMNShape>
